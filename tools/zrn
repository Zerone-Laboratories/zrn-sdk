#!/bin/sh
# zrn: build for the phone on the PC, upload over ssh, run there. A thin wrapper over cmake, podman, rsync and ssh.
#
#   zrn [options] sysroot                  one time: make the aarch64 sysroot from an Arch Linux ARM container
#   zrn [options] build <dir>              cross build of the project in <dir> (examples/helloworld, ...)
#   zrn [options] setup-key <host>         copy your ssh key to the phone (needs -p), then no password is needed
#   zrn [options] push <host> <dir>        upload the binary, the fonts and the theme
#   zrn [options] run <host> <dir> [args]  push, then run on the phone with the output in this terminal
#   zrn [options] watch <host> <dir>       run again whenever a source file changes (needs inotifywait)
#
# options (before the command):
#   -u, --user <name>      login on the phone, default alarm (ZRN_USER); user@host in <host> wins
#   -p, --password <pw>    password; "-p -" asks for it without echo (ZRN_PASSWORD). Without it: key authentication only
#   -i, --key <file>       private key to use (ZRN_KEY); by default the agent and ~/.ssh/id_*
#
# <host> is an address (USB-LAN 192.168.7.2, Wi-Fi, phone.local) or an alias of ~/.ssh/config; ZRN_HOST is the default.
# A password on the command line shows in `ps` and in the shell history: use "-p -" or ZRN_PASSWORD, and only for setup-key.
# Nothing is saved anywhere: not the password, not the user, not the host.
# Environment: ZRN_PRESET (phone-release), ZRN_SYSROOT (~/.cache/zrn/sysroot), ZRN_REMOTE_DIR (zrn-dev, under the home
# of the phone user), ZRN_WAYLAND_DISPLAY (the first wayland-* socket of the phone user).

set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
preset=${ZRN_PRESET:-phone-release}
sysroot=${ZRN_SYSROOT:-$HOME/.cache/zrn/sysroot}
remote=${ZRN_REMOTE_DIR:-zrn-dev}
image=zrn-build
user=${ZRN_USER:-alarm}
key=${ZRN_KEY:-}
password=${ZRN_PASSWORD:-}
askpass=""
ssh_base=""

die() { printf 'zrn: %s\n' "$*" >&2; exit 1; }

usage() {
	sed -n '/^#/!q; 2,$p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }

# the project directory as an absolute path, and the name of its binary
project() {
	[ -n "${1:-}" ] || die "which project? e.g. examples/helloworld"
	dir=$(cd "$1" 2>/dev/null && pwd) || die "no such directory: $1"
	[ -f "$dir/CMakePresets.json" ] || die "$dir has no CMakePresets.json"
	name=$(basename "$dir")
	binary=$dir/build/$preset/$name
}

# host is the first argument, unless ZRN_HOST is set and the first argument is already the project directory
take_host() {
	if [ -n "${ZRN_HOST:-}" ] && [ -f "${1:-}/CMakePresets.json" ]; then
		host=$ZRN_HOST
		consumed=0
	else
		host=${1:-${ZRN_HOST:-}}
		consumed=1
	fi
	[ -n "$host" ] || die "which device? e.g. zrn run 192.168.7.2 examples/helloworld, or set ZRN_HOST"
}

# how ssh and rsync reach the phone: the user, the key, and the password through SSH_ASKPASS (never through argv)
auth_setup() {
	[ -z "$ssh_base" ] || return 0
	need ssh
	ssh_base="ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -l '$user'"
	[ -z "$key" ] || ssh_base="$ssh_base -i '$key'"
	if [ -n "$password" ]; then
		askpass=$(mktemp "${TMPDIR:-/tmp}/zrn-askpass.XXXXXX")
		trap 'rm -f "$askpass"' EXIT
		printf '#!/bin/sh\nprintf "%%s\\n" "$ZRN_PASSWORD"\n' > "$askpass"
		chmod 700 "$askpass"
		ZRN_PASSWORD=$password SSH_ASKPASS=$askpass SSH_ASKPASS_REQUIRE=force
		export ZRN_PASSWORD SSH_ASKPASS SSH_ASKPASS_REQUIRE
		ssh_base="$ssh_base -o NumberOfPasswordPrompts=1"
	else
		# no password: a key or nothing, and no prompt that hangs the script
		ssh_base="$ssh_base -o BatchMode=yes"
	fi
}

zssh() { auth_setup; eval "$ssh_base \"\$@\""; }
zrsync() { auth_setup; need rsync; rsync -e "$ssh_base" "$@"; }

cmd_sysroot() {
	need podman
	need tar
	tmp=$(mktemp -d "${sysroot}.XXXXXX" 2>/dev/null || { mkdir -p "$(dirname "$sysroot")" && mktemp -d "${sysroot}.XXXXXX"; })
	trap 'rm -rf "$tmp"; [ -z "${cid:-}" ] || podman rm -f "$cid" >/dev/null 2>&1 || true' EXIT
	podman build --platform linux/arm64 -t "$image" -f "$root/tools/Dockerfile" "$root/tools"
	cid=$(podman create --platform linux/arm64 "$image" /bin/true)
	podman export "$cid" | tar -x -C "$tmp" --exclude='./dev/*' --exclude='./run/*' --no-same-owner --no-same-permissions
	rm -rf "$sysroot"
	mv "$tmp" "$sysroot"
	trap - EXIT
	podman rm -f "$cid" >/dev/null
	printf 'sysroot: %s\n' "$sysroot"
}

cmd_build() {
	project "${1:-}"
	need cmake
	need clang
	need ninja
	ZRN_SYSROOT=$sysroot
	# the build runs aarch64 helpers of the sysroot (wayland-scanner) under qemu-user: it finds their loader here
	QEMU_LD_PREFIX=$sysroot
	export ZRN_SYSROOT QEMU_LD_PREFIX
	(cd "$dir" && cmake --preset "$preset" && cmake --build --preset "$preset")
	[ -f "$binary" ] || die "built, but there is no binary $binary (a library project?)"
	printf 'built: %s\n' "$binary"
}

cmd_setup_key() {
	take_host "$@"
	[ -n "$password" ] || die "setup-key needs the password: zrn -p - setup-key $host"
	need ssh-copy-id
	need ssh-keygen
	pub=${key:+$key.pub}
	[ -n "$pub" ] || pub=$(ls "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_rsa.pub 2>/dev/null | head -n 1 || true)
	if [ -z "$pub" ]; then
		ssh-keygen -q -t ed25519 -N "" -f "$HOME/.ssh/id_ed25519"
		pub=$HOME/.ssh/id_ed25519.pub
	fi
	[ -f "$pub" ] || die "no public key $pub"
	case $host in *@*) target=$host ;; *) target=$user@$host ;; esac
	# only the askpass environment of auth_setup is needed here: ssh-copy-id builds its own ssh command
	auth_setup
	ssh-copy-id -i "$pub" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o NumberOfPasswordPrompts=1 "$target"
	printf 'key %s is on %s: run without a password from now on\n' "$pub" "$target"
}

cmd_push() {
	take_host "$@"
	[ $# -ge "$consumed" ] && shift "$consumed"
	project "${1:-}"
	[ -f "$binary" ] || die "not built: run zrn build $1 first"
	# the fonts and the theme change rarely: rsync sends only what differs
	zssh "$host" "mkdir -p '$remote/$name' '$remote/share'"
	zrsync -az --info=stats0,name1 "$binary" "$host:$remote/$name/"
	zrsync -az --delete "$root/zrnui/fonts/selawik/" "$host:$remote/share/fonts/"
	zrsync -az "$root/zrnui/theme/theme.ini" "$host:$remote/share/theme.ini"
}

cmd_run() {
	take_host "$@"
	[ $# -ge "$consumed" ] && shift "$consumed"
	project "${1:-}"
	[ $# -lt 1 ] || shift
	cmd_build "$dir"
	cmd_push "$host" "$dir"
	args=""
	for a in "$@"; do args="$args '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"; done
	# the session of the phone user: its runtime dir and the first Wayland socket in it
	zssh -t "$host" "
		uid=\$(id -u)
		export XDG_RUNTIME_DIR=\${XDG_RUNTIME_DIR:-/run/user/\$uid}
		export WAYLAND_DISPLAY=${ZRN_WAYLAND_DISPLAY:-}
		[ -n \"\$WAYLAND_DISPLAY\" ] || WAYLAND_DISPLAY=\$(cd \"\$XDG_RUNTIME_DIR\" && ls -d wayland-* 2>/dev/null | grep -v '\\.lock\$' | head -n 1)
		[ -n \"\$WAYLAND_DISPLAY\" ] || { echo 'no Wayland socket in '\$XDG_RUNTIME_DIR >&2; exit 1; }
		export ZRNUI_FONT_DIR=\$HOME/$remote/share/fonts ZRNUI_THEME=\$HOME/$remote/share/theme.ini
		exec \$HOME/$remote/$name/$name$args
	"
}

cmd_watch() {
	need inotifywait
	take_host "$@"
	[ $# -ge "$consumed" ] && shift "$consumed"
	project "${1:-}"
	while :; do
		cmd_run "$host" "$dir" || true
		printf '\nzrn: waiting for a change in %s ...\n' "$dir"
		inotifywait -qq -r -e modify,create,delete,move --exclude '(/build/|/\.git/)' "$dir" "$root/zrnui/src" "$root/zrnui/include" "$root/zrnapp/src"
	done
}

# the options come before the command, so they cannot be mistaken for the arguments of the app after `run`
while [ $# -gt 0 ]; do
	case $1 in
		-u|--user) [ $# -ge 2 ] || die "$1 needs a name"; user=$2; shift 2 ;;
		-i|--key) [ $# -ge 2 ] || die "$1 needs a file"; key=$2; shift 2 ;;
		-p|--password)
			[ $# -ge 2 ] || die "$1 needs a password, or - to be asked"
			if [ "$2" = "-" ]; then
				[ -r /dev/tty ] || die "no terminal to ask the password on"
				printf 'password of %s: ' "$user" >/dev/tty
				stty -echo </dev/tty
				read -r password </dev/tty || password=""
				stty echo </dev/tty
				printf '\n' >/dev/tty
			else
				password=$2
			fi
			shift 2 ;;
		-h|--help|help) usage 0 ;;
		-*) die "unknown option $1 (zrn --help)" ;;
		*) break ;;
	esac
done

[ $# -ge 1 ] || usage 1
sub=$1
shift
case $sub in
	sysroot) cmd_sysroot "$@" ;;
	build) cmd_build "$@" ;;
	setup-key) cmd_setup_key "$@" ;;
	push) cmd_push "$@" ;;
	run) cmd_run "$@" ;;
	watch) cmd_watch "$@" ;;
	*) usage 1 ;;
esac
