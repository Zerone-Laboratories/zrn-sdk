#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
# Runs a .zexec: `zrn-exec app.zexec [args]`, or the package itself (#!/usr/bin/env zrn-exec).
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from zrnlib.launcher import launch  # noqa: E402

if len(sys.argv) < 2:
    print("usage: zrn-exec APP.zexec [ARGS...]", file=sys.stderr)
    sys.exit(2)
sys.exit(launch(sys.argv[1], sys.argv[2:]))
